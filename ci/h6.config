# HarmonyOS 6 enablement for the cas 4.19.325 kernel.
# Derived from the SM-G986N / y2q HarmonyOS 6 port (same SM8250 / Adreno 650).
# Applied on top of vendor/kona_defconfig + vendor/xiaomi/cas.config.

CONFIG_ACCESS_TOKENID=y
CONFIG_BINDER_SENDER_INFO=y

CONFIG_FS_VERITY=y
CONFIG_FS_VERITY_BUILTIN_SIGNATURES=y
CONFIG_CRYPTO_ECC=y
CONFIG_CRYPTO_ECDSA=y
CONFIG_CRYPTO_ECDH=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_BLACKLIST_KEYRING=y

# Donor images are EROFS, mounted read-only through loop devices.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# arm64 32-bit compat: without this, include/linux/filter.h fails with
# "unknown type name compat_uptr_t" on the first CI build.
CONFIG_COMPAT=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUP_PIDS=y
CONFIG_FAIR_GROUP_SCHED=y

# y2q A1: with BINDERFS enabled the traditional /dev/binder char device is
# not registered and HarmonyOS userspace gets ENOENT.
# CONFIG_ANDROID_BINDERFS is not set
